# Include inside http {}. Replace the domain and certificate paths explicitly.
# Only native same-host deployment: the application is bound to 127.0.0.1.
server {
    listen 443 ssl default_server;
    server_name _;
    ssl_certificate /etc/lidian/tls/fullchain.pem;
    ssl_certificate_key /etc/lidian/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    return 400;
}
server {
    listen 443 ssl;
    server_name lidian.example.invalid;
    ssl_certificate /etc/lidian/tls/fullchain.pem;
    ssl_certificate_key /etc/lidian/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 2100k;
    client_body_timeout 20s;
    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 120s;
        proxy_connect_timeout 5s;
        proxy_send_timeout 30s;
    }
}
