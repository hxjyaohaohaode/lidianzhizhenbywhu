# Template only: scripts/start.py reads .env if you explicitly create it; shell values take precedence.
APP_ENV=development
APP_ORIGIN=http://127.0.0.1:8000
DATA_DIR=.runtime/workbench
REGISTRATION_CODE=
TAVILY_API_KEY=
# Optional operator-owned AI: disabled by default. All three values are required.
# Reviewed domestic official HTTPS chat/completions routes only; no model presets.
# See docs/RENDER_READINESS_20261010.md for allowed base URLs.
# Missing/invalid values leave local tools and private account connections usable.
SERVER_AI_ENABLED=false
SERVER_AI_BASE_URL=
SERVER_AI_MODEL=
SERVER_AI_API_KEY=
# Private account connections remain available and keep default-selection priority.
